# ---- Khet2Kitchen frontend environment ----
# Copy to `.env` and adjust. NEVER put secrets (API/payment/DB keys) in the frontend.
# Only values prefixed with VITE_ are exposed to the browser — keep them non-secret.

# Base URL for the REST API. Leave as "/api" to use the Vite dev proxy (see vite.config.ts),
# or set to a full URL like https://api.khet2kitchen.in in production.
VITE_API_BASE_URL=/api

# Data source: "mock" uses the in-app mock services (default for the UI prototype);
# "live" makes the service layer call the real REST API instead.
VITE_DATA_SOURCE=mock

# Dev-only: where the /api proxy points (NestJS backend).
VITE_API_PROXY=http://localhost:4000
