# ==========================================
# KHET2KITCHEN ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://k2k_user:k2k_password_secure@localhost:5432/khet2kitchen_db?schema=public"

# 2. AUTHENTICATION & SECURITY
# Minimum 32-character secret for signing JWT session cookies
JWT_SECRET="khet2kitchen_super_secret_jwt_key_2026_min32chars_secure"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 3. PLATFORM MONETIZATION CONFIGURATION
# Default platform commission percent charged on orders (e.g., 3.0 = 3%)
DEFAULT_PLATFORM_COMMISSION_PERCENT=3.0
# Base delivery fee for Khet2Kitchen transport logistics (in INR)
DEFAULT_LOGISTICS_BASE_FEE=250.0
# Fee per km beyond the base distance radius (in INR)
DEFAULT_LOGISTICS_PER_KM_FEE=12.0
# Default monthly subscription price for commercial buyers (in INR)
DEFAULT_BUYER_SUBSCRIPTION_MONTHLY_FEE=499.0

# 4. PAYMENT GATEWAY (Optional for production; mock mode active by default)
# When left blank or with test placeholders, Khet2Kitchen operates in transparent Mock Payment Mode
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"

# 5. COMMUNICATIONS / SMS / EMAIL (Optional)
# In-app notifications are stored persistently in the database by default.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@khet2kitchen.in"
SMTP_PASS="placeholder_password"
